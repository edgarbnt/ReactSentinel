{
  "name": "@edgarbrunet/react-sentinel",
  "version": "0.1.0",
  "description": "Runtime debugger for AI agents — MCP server for live React inspection, bug replay, and fix validation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "react-sentinel": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/agent-pack/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && echo '✅ Type-check passed'",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "e2e:diagnose": "RS_E2E_URL=http://127.0.0.1:4173 tsx scripts/e2e-diagnose.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "playwright": "^1.52.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "react",
    "debugging",
    "ai",
    "playwright",
    "devtools"
  ],
  "license": "MIT"
}
