{
  "name": "react-sentinel",
  "version": "0.1.0",
  "description": "Autonomous debugging infrastructure for AI agents — MCP server bridging AI terminals to browser runtime",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "react-sentinel": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && echo '✅ Type-check passed'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "playwright": "^1.52.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "react",
    "debugging",
    "ai",
    "playwright",
    "devtools"
  ],
  "license": "MIT"
}
